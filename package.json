    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@types/three": "^0.184.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.19",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.3",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.22.3",
    "typescript": "5.8.2"
  }
