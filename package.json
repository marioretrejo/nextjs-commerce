    "dotenv": "^17.4.2",
    "geist": "^1.3.1",
    "groq-sdk": "^1.2.0",
    "libphonenumber-js": "^1.13.4",
    "livekit-client": "^2.19.0",
    "livekit-server-sdk": "^2.15.3",
    "lucide-react": "^0.511.0",
    "next": "15.5.19",
    "next-intl": "^4.13.0",
