{
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "agent": "tsx agent/worker_core.ts dev",
    "agent:prod": "node dist/worker.js start",
    "start:prod": "node dist/worker.js start",
    "build:worker:cjs": "node_modules/.pnpm/node_modules/.bin/esbuild agent/worker_core.ts --bundle --platform=node --format=cjs --target=node24 --tsconfig=tsconfig.json --external:@livekit/agents --external:@livekit/agents-plugin-deepgram --external:@livekit/agents-plugin-openai --external:@livekit/agents-plugin-cartesia --external:@livekit/rtc-node --external:fsevents --outfile=dist/worker.js",
    "build:worker:esm": "node_modules/.pnpm/node_modules/.bin/esbuild agent/worker_core.ts --bundle --platform=node --format=esm --target=node24 --tsconfig=tsconfig.json --external:@livekit/agents --external:@livekit/agents-plugin-deepgram --external:@livekit/agents-plugin-openai --external:@livekit/agents-plugin-cartesia --external:@livekit/rtc-node --external:fsevents --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --outfile=dist/worker.mjs",
    "build:worker": "pnpm build:worker:cjs && pnpm build:worker:esm",
    "start:worker": "tsx agent/worker.ts start",
    "start:operational-worker": "tsx agent/operational_worker.ts",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false next lint",
    "prettier": "prettier --write --ignore-unknown .",
    "prettier:check": "prettier --check --ignore-unknown .",
    "test": "pnpm prettier:check && pnpm lint && pnpm test:unit",
    "test:unit": "tsx --test agent/tests/call-lifecycle.test.ts agent/tests/call-events-repository.test.ts agent/tests/twilio-validation.test.ts agent/tests/status-mapping.test.ts agent/tests/call-events-backfill.test.ts agent/tests/provider-pricing.test.ts agent/tests/billing-tracker.test.ts agent/tests/call-cost-backfill.test.ts agent/tests/watchdog-billing.test.ts agent/tests/tts-provider-router.test.ts agent/tests/circuit-breaker.test.ts agent/tests/analytics-webhooks.test.ts agent/tests/dynamic-routing.test.ts agent/tests/llm-provider-router.test.ts agent/tests/human-transfer.test.ts agent/tests/dial-eligibility.test.ts agent/tests/campaign-dialer.test.ts agent/tests/post-call-jobs.test.ts agent/tests/load-test-harness.test.ts agent/tests/campaign-api.test.ts agent/tests/provider-health.test.ts agent/tests/alerting.test.ts agent/tests/production-readiness.test.ts agent/tests/twilio-webhook.test.ts",
    "load:test": "tsx scripts/load-test-calls.ts",
    "scraper:install": "pnpm add -D playwright && npx playwright install chromium",
    "scraper": "node scraper/tracker-scraper.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write",
    "*.{ts,tsx}": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --fix --max-warnings=0"
  },
  "dependencies": {
    "@cartesia/cartesia-js": "^3.1.0",
