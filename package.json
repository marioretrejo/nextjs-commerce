    "tailwind-merge": "^3.3.0",
    "three": "^0.184.0",
    "twilio": "^6.0.2",
    "wavesurfer.js": "^7.12.7",
    "zod": "^3.25.30"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
