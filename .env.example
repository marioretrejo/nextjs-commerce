# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_WEBHOOK_VALIDATION_DISABLED=false

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_PRICE_PRO=your-stripe-price-id-pro
STRIPE_PRICE_SCALE=your-stripe-price-id-scale

# Resend (email)
RESEND_API_KEY=your-resend-api-key

# HubSpot (OAuth CRM integration)
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret

# Voice / AI providers
CARTESIA_API_KEY=your-cartesia-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
GROQ_API_KEY=gsk_your-groq-api-key
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# App
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXTAUTH_URL=https://your-app.vercel.app
RENDER_EXTERNAL_URL=https://your-render-service.onrender.com
ADMIN_EMAIL=admin@your-domain.com
PORT=3000

# Secrets - generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your-internal-api-secret
CRON_SECRET=your-cron-secret
VOICEOS_WEBHOOK_SIGNING_SECRET=your-voiceos-webhook-signing-secret

# LiveKit - Core
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# LiveKit SIP / outbound calling
LIVEKIT_SIP_HOST=sip.livekit.run
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=your-livekit-outbound-trunk-id
SUPPORT_TRANSFER_NUMBER=+18005551234
VOICEOS_GLOBAL_TRANSFER_FALLBACK=+18005551234

# Supabase Storage S3 - generate in Supabase dashboard > Storage > S3 Access Keys
SUPABASE_S3_ACCESS_KEY=your-supabase-s3-access-key
SUPABASE_S3_SECRET_KEY=your-supabase-s3-secret-key

# LiveKit Edge Routing - optional regional overrides
LIVEKIT_URL_US_EAST=
LIVEKIT_URL_US_WEST=
LIVEKIT_URL_EU_WEST=
LIVEKIT_URL_AP_SE=

# Upstash Redis (API rate limiting)
UPSTASH_REDIS_REST_URL=https://your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Operational worker feature flags
VOICEOS_OPERATIONAL_WORKER_ENABLED=false
VOICEOS_RUN_POST_CALL_JOBS=true
VOICEOS_RUN_PROVIDER_HEALTH=true
VOICEOS_RUN_ALERTS=true
VOICEOS_RUN_CAMPAIGN_DIAL=false
VOICEOS_RUN_RECOVERY=false

# Alert delivery
VOICEOS_ALERTING_SEND_EXTERNAL=false
VOICEOS_ALERTING_SLACK_WEBHOOK_URL=
VOICEOS_ALERTING_DEFAULT_EMAIL=

# Load/canary tests - keep disabled in production
VOICEOS_LOAD_TEST_MODE=false
VOICEOS_LOAD_TEST_SEND_WEBHOOKS=false
VOICEOS_ALLOW_PROD_LOAD_TEST=false

# Marketing finance tracker
TRACKER_USER=
TRACKER_PASS=
TRACKER_COOKIES=

# Observability - optional
SENTRY_DSN=
POSTHOG_API_KEY=
